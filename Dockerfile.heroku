FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

WORKDIR /opt/xui

# Dependencies + libssl1.1 + socat (for Heroku $PORT forwarding)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    dos2unix \
    iproute2 \
    net-tools \
    python-is-python3 \
    python3 \
    python3-dev \
    socat \
    sudo \
    unzip \
    wget \
    && wget -q https://security.ubuntu.com/ubuntu/pool/main/o/openssl/libssl1.1_1.1.1f-1ubuntu2.23_amd64.deb \
    && dpkg -i libssl1.1_1.1.1f-1ubuntu2.23_amd64.deb || apt-get install -f -y \
    && rm -f libssl1.1_1.1.1f-1ubuntu2.23_amd64.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY docker/configure.sh /configure.sh
COPY docker/install-heroku.sh /install-heroku.sh
COPY docker/heroku-entrypoint.sh /heroku-entrypoint.sh

RUN dos2unix /configure.sh /install-heroku.sh /heroku-entrypoint.sh \
    && chmod +x /configure.sh /install-heroku.sh /heroku-entrypoint.sh

# Install XUI.one during image build (Heroku dyno must start fast)
RUN /install-heroku.sh

CMD ["/heroku-entrypoint.sh"]
